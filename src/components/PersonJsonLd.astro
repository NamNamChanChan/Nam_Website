---
import config from "@/config";

const sameAs = config.socials
  .map(social => social.url)
  .filter(url => url !== "#" && !url.startsWith("mailto:"));

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Nam Chan",
  alternateName: ["Alfred Nam", "Kwun Nam Chan", "陳冠南"],
  url: config.site.url,
  jobTitle: [
    "Co-founder and Chief Information Officer at AceSpeak",
    "Chief Technology Officer at Wistkey",
  ],
  description:
    "Co-founder and CIO of AceSpeak, and CTO at Wistkey. Building human-centred AI products and production AI systems between London and Hong Kong.",
  worksFor: [
    {
      "@type": "Organization",
      name: "AceSpeak",
      url: "https://acespeak.uk",
    },
    {
      "@type": "Organization",
      name: "Wistkey",
      url: "https://wistkey.com",
    },
  ],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "The Chinese University of Hong Kong",
    url: "https://www.cuhk.edu.hk/",
  },
  knowsAbout: [
    "Artificial Intelligence",
    "Large Language Models",
    "Agentic AI",
    "On-premises AI deployment",
    "Retrieval-Augmented Generation",
    "Enterprise AI adoption",
    "AI speaking practice",
    "Software engineering delivery",
  ],
  knowsLanguage: ["en", "zh-Hant"],
  ...(sameAs.length > 0 && { sameAs }),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)}
></script>
